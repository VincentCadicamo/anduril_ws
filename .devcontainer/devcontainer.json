{
  "name": "anduril-ros2-humble",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USER_UID": "${localEnv:USER_UID:1000}",
      "USER_GID": "${localEnv:USER_GID:1000}"
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "workspaceFolder": "/workspaces/anduril_ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/anduril_ws,type=bind,consistency=cached",

  "remoteUser": "ros",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--pid=host",
    "--device=/dev/dxg",
    "-v", "/usr/lib/wsl:/usr/lib/wsl:ro"
  ],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "unix:/mnt/wslg/runtime-dir/PulseServer",
    "LD_LIBRARY_PATH": "/usr/lib/wsl/lib:${LD_LIBRARY_PATH}",
    "ROS_DOMAIN_ID": "0",
    "ROS_LOCALHOST_ONLY": "0",
    "GALLIUM_DRIVER": "d3d12",
    "MESA_GL_VERSION_OVERRIDE": "4.6",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "CYCLONEDS_URI": "file:///workspaces/anduril_ws/.devcontainer/cycloneds_pcie.xml"
  },

  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=/mnt/wslg/runtime-dir,target=/mnt/wslg/runtime-dir,type=bind,consistency=cached"
  ],

  "customizations": {
    "jetbrains": {
      "backend": "CLion"
    },
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "twxs.cmake"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
