Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Path1
        - /TrackImage1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: global
    Frame Rate: 30
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 1
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /pathimu
        Reliability Policy: Reliable
        Depth: 10
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 1
      Topic:
        Value: /ov_msckf/odomimu
        Reliability Policy: Reliable
        Depth: 10
      Covariance:
        Orientation:
          Alpha: 0.5
          Scale: 1
        Position:
          Alpha: 0.3
          Scale: 1
        Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: MSCKF Points
      Enabled: true
      Size (Pixels): 3
      Style: Points
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Topic:
        Value: /ov_msckf/points_msckf
        Reliability Policy: Reliable
        Depth: 10
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM Points
      Enabled: true
      Size (Pixels): 4
      Style: Points
      Color: 0; 170; 255
      Color Transformer: FlatColor
      Topic:
        Value: /ov_msckf/points_slam
        Reliability Policy: Reliable
        Depth: 10
    - Class: rviz_default_plugins/Image
      Name: TrackImage
      Enabled: true
      Topic:
        Value: /trackhist
        Reliability Policy: Reliable
        Depth: 10
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.7
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Views:
    collapsed: false
