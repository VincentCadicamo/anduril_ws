<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>anduril_bringup</name>
  <version>0.0.0</version>
  <description>Top-level bringup package: launches the full drone stack (sim bridge, VIO, RViz).</description>
  <maintainer email="vcadicamo@icloud.com">ros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>anduril_sim_bridge</exec_depend>
  <exec_depend>anduril_manual_control</exec_depend>
  <exec_depend>anduril_vslam</exec_depend>
  <exec_depend>ov_msckf</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
